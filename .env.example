# Copy to .env and fill in. .env is gitignored.

# --- database (matches docker-compose.yml) -----------------------------------
POSTGRES_DB=dari
POSTGRES_USER=dari
POSTGRES_PASSWORD=dari_local
DB_URL=jdbc:postgresql://localhost:5432/dari

# --- firebase admin (backend) ------------------------------------------------
# Absolute or repo-relative path to the service-account JSON. Not committed.
FIREBASE_CREDENTIALS_PATH=./infra/firebase/service-account.json
FIREBASE_PROJECT_ID=

# --- api ---------------------------------------------------------------------
API_PORT=8080
# Comma-separated, binds to a List<String> (SecurityConfig.corsConfigurationSource).
# :8081 is apps/mobile's own dev convenience -- `expo start --web`, useful in
# an environment with no iOS/Android simulator -- not a real product target;
# add it only if you actually run that.
DARI_WEB_ORIGIN=http://localhost:3000,http://localhost:8081
