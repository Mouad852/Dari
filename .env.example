# Copy to .env and fill in. .env is gitignored.

# --- database (matches docker-compose.yml) -----------------------------------
POSTGRES_DB=dari
POSTGRES_USER=dari
POSTGRES_PASSWORD=dari_local
DB_URL=jdbc:postgresql://localhost:5432/dari

# --- firebase admin (backend) ------------------------------------------------
# Absolute or repo-relative path to the service-account JSON. Not committed.
FIREBASE_CREDENTIALS_PATH=./infra/firebase/service-account.json
# Not read by the API (it takes the project from the service-account file).
FIREBASE_PROJECT_ID=

# --- api ---------------------------------------------------------------------
API_PORT=8080
# Comma-separated, binds to a List<String> (SecurityConfig.corsConfigurationSource).
# :8081 is apps/mobile's own dev convenience -- `expo start --web`, useful in
# an environment with no iOS/Android simulator -- not a real product target;
# add it only if you actually run that.
DARI_WEB_ORIGIN=http://localhost:3000,http://localhost:8081

# --- media ------------------------------------------------------------------
# Keep local for development. Production S3-compatible storage requires all of
# the values below through the deployment secret store, never in this file.
DARI_MEDIA_PROVIDER=local
DARI_MEDIA_PUBLIC_BASE_URL=/uploads
DARI_MEDIA_S3_ENDPOINT=http://localhost:9000
DARI_MEDIA_S3_REGION=eu-west-1
DARI_MEDIA_S3_ACCESS_KEY=
DARI_MEDIA_S3_SECRET_KEY=
DARI_MEDIA_S3_BUCKET=dari-media

# =============================================================================
# PRODUCTION (API)
# =============================================================================
# Everything below is for a production deployment. Values come from the
# platform's secret store as environment variables; never from this file, and
# never committed. Empty on purpose.
#
# With SPRING_PROFILES_ACTIVE=production the API refuses to start if any
# required variable is missing or unsafe, and names each one. Check a host
# before a release with infra/scripts/validate-production-config.sh (or .ps1).
# The production profile ignores the development defaults above: no localhost
# database, no dari_local password, no local media.
#
# SPRING_PROFILES_ACTIVE=production
#
# --- database (required) -----------------------------------------------------
# DB_URL=jdbc:postgresql://<host>:5432/<database>
# POSTGRES_USER=
# POSTGRES_PASSWORD=                          # secret
# Optional. Server-side limit for application queries; migrations are exempt.
# DARI_DB_STATEMENT_TIMEOUT=30s
#
# --- web / auth (required) ---------------------------------------------------
# Comma-separated https origins, no path or trailing slash.
# DARI_WEB_ORIGIN=https://<web domain>
# Path to the service-account JSON, mounted read-only into the container.
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
# Secret in Parameter Store SecureString; minimum 32 characters. Rotating it
# moves every public listing pin, so coordinate changes are expected after rotation.
# DARI_LOCATION_FUZZ_SECRET=
#
# --- media (required) --------------------------------------------------------
# DARI_MEDIA_PROVIDER=s3
# Public https origin photos are served from (CDN in front of the bucket).
# DARI_MEDIA_PUBLIC_BASE_URL=https://<media domain>
# DARI_MEDIA_S3_ENDPOINT=https://<S3-compatible endpoint>
# DARI_MEDIA_S3_REGION=
# DARI_MEDIA_S3_BUCKET=
# DARI_MEDIA_S3_ACCESS_KEY=                   # secret
# DARI_MEDIA_S3_SECRET_KEY=                   # secret
# DARI_MEDIA_CLEANUP_INTERVAL_MS=60000        # optional
#
# --- notifications / SMTP (required) -----------------------------------------
# Defaults to true in production; false stops startup.
# DARI_NOTIFICATIONS_ENABLED=true
# DARI_NOTIFICATIONS_FROM=no-reply@<verified sender domain>
# SMTP_HOST=
# SMTP_PORT=587                               # optional, STARTTLS port; 465 is not supported
# SMTP_USERNAME=
# SMTP_PASSWORD=                              # secret
# Optional outbox tuning (application.yml defaults shown).
# DARI_NOTIFICATIONS_BATCH_SIZE=50
# DARI_NOTIFICATIONS_MAX_ATTEMPTS=5
# DARI_NOTIFICATIONS_RETRY_DELAY_SECONDS=60
# DARI_NOTIFICATIONS_STALE_AFTER_MINUTES=15
# DARI_NOTIFICATIONS_DELIVERY_INTERVAL_MS=30000
#
# --- rate limits (optional; application.yml defaults shown) -------------------
# Process-local; see docs/PRODUCTION_OPERATIONS.md before running more than one
# API instance.
# DARI_RATE_LIMIT_REPORT_MAX=5
# DARI_RATE_LIMIT_REPORT_WINDOW=PT1H
# DARI_RATE_LIMIT_MESSAGE_MAX=30
# DARI_RATE_LIMIT_MESSAGE_WINDOW=PT1M
# DARI_RATE_LIMIT_LISTING_MAX=5
# DARI_RATE_LIMIT_LISTING_WINDOW=PT1H
# DARI_RATE_LIMIT_UPLOAD_MAX=20
# DARI_RATE_LIMIT_UPLOAD_WINDOW=PT1H
# DARI_RATE_LIMIT_SIGNUP_MAX=5
# DARI_RATE_LIMIT_SIGNUP_WINDOW=PT1H
# DARI_RATE_LIMIT_SEARCH_MAX=120
# DARI_RATE_LIMIT_SEARCH_WINDOW=PT1M
# DARI_RATE_LIMIT_MAX_TRACKED_KEYS=100000
# Production only: Java regex matching the target-facing private addresses of
# the ALB nodes (for example ^10\.0\.(?:10|11)\.\d{1,3}$). Do not trust
# internet-facing client ranges or a broad private range.
# DARI_TRUSTED_PROXY_IPS=
#
# --- JVM (optional) ----------------------------------------------------------
# Extra JVM flags for the container; the image already sets MaxRAMPercentage=75.
# JAVA_TOOL_OPTIONS=
