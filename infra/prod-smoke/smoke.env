# API environment for the LOCAL production smoke stack (docker-compose.yml in
# this folder). Complete production variable set, smoke-only placeholder values:
# none of these protect anything real. Never copy them into a real deployment.
#
# Docker env-file syntax: no quotes, no interpolation, one VAR=value per line.
SPRING_PROFILES_ACTIVE=production

DB_URL=jdbc:postgresql://db:5432/dari
POSTGRES_USER=dari
POSTGRES_PASSWORD=smoke-db-password-not-a-secret

DARI_WEB_ORIGIN=https://smoke.dari.invalid
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
DARI_LOCATION_FUZZ_SECRET=smoke-only-location-fuzz-secret-not-for-production

DARI_MEDIA_PROVIDER=s3
# Must be https, like the production CDN origin. The smoke stack never loads
# images through it; objects are checked in MinIO directly.
DARI_MEDIA_PUBLIC_BASE_URL=https://media.smoke.dari.invalid/dari-media
DARI_MEDIA_S3_ENDPOINT=http://minio:9000
DARI_MEDIA_S3_REGION=us-east-1
DARI_MEDIA_S3_BUCKET=dari-media
DARI_MEDIA_S3_ACCESS_KEY=smoke-access-key
DARI_MEDIA_S3_SECRET_KEY=smoke-secret-key-not-a-secret

DARI_NOTIFICATIONS_FROM=no-reply@smoke.dari.invalid
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=smoke
SMTP_PASSWORD=smoke-smtp-password-not-a-secret
# Smoke-only: trust Mailpit's throwaway self-signed certificate. A real SMTP
# provider presents a publicly trusted certificate and needs nothing here.
SPRING_APPLICATION_JSON={"spring":{"mail":{"properties":{"mail.smtp.ssl.trust":"mailpit"}}}}
