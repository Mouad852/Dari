# Required at build/startup for a production launch. next.config.mjs refuses to
# build or start without every value below (the single production gate).
# Placeholders only: *.example.invalid never resolves. Do not put API secrets in
# any NEXT_PUBLIC_ variable; those are inlined into browser JavaScript.

# Browser -> API. PUBLIC: shipped to every visitor, must be the public HTTPS
# API origin and end in /api/v1.
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid/api/v1

# Next.js server -> API (Server Components, metadata, sitemap, robots). SERVER
# ONLY: may name an internal address that browsers cannot reach, so nothing
# rendered for the browser is ever built from it (media URLs included).
API_BASE_URL=https://api.internal.example.invalid/api/v1

NEXT_PUBLIC_SITE_URL=https://www.example.invalid

# Public HTTPS origins that serve photos and avatars, comma-separated, no path.
# PUBLIC: they populate the CSP img-src. The FIRST origin prefixes root-relative
# /uploads/... paths; absolute S3/CloudFront URLs from the API are used as-is and
# their origin must also be listed here.
NEXT_PUBLIC_MEDIA_ORIGINS=https://media.example.invalid

NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-public-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=example.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=example
NEXT_PUBLIC_RELEASE_VERSION=2026.09.20

# Legal release values are owner/counsel supplied; placeholders must not ship.
DARI_LEGAL_ENTITY_NAME=
DARI_LEGAL_ADDRESS=
DARI_LEGAL_REGISTRATION=
DARI_LEGAL_CONTACT=
DARI_LEGAL_JURISDICTION=
DARI_LEGAL_COMPLAINT_AUTHORITY=
DARI_LEGAL_RETENTION=
DARI_LEGAL_PROCESSORS=
DARI_LEGAL_LAWFUL_BASES=
DARI_LEGAL_EFFECTIVE_DATE=
DARI_LEGAL_VERSION=
