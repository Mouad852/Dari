# Copy to .env.local. Public Firebase config is not secret -- it identifies the
# project. The service-account key is the secret, and it lives only on the API.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Browser-side base URL for the API. Production must be the public HTTPS API
# origin, including /api/v1; never put a private/internal hostname here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Server-side base URL, used by Server Components. Same value in local dev;
# differs in production when the API is reachable on an internal address.
API_BASE_URL=http://localhost:8080/api/v1

# The client sends Firebase's refreshed ID token as an Authorization: Bearer
# header. Tokens are not stored in this file, localStorage, cookies, or URLs.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
