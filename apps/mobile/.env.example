# Copy to .env and fill in for local development. Expo loads EXPO_PUBLIC_*
# vars automatically (inlined at bundle time) -- no extra config needed.
#
# Point this at the API's real local port, not the app's own 8080 default --
# infra/scripts/dev.ps1's `api` task reads API_PORT from the repo root's
# .env, which this dev environment has set to 8055 (see apps/web's own
# .env.local for the same value web uses).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
