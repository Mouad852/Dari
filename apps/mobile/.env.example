# Copy to .env and fill in for local development. Expo loads EXPO_PUBLIC_*
# vars automatically (inlined at bundle time) -- no extra config needed.
#
# Match this to the repo root .env's API_PORT (default 8080; see
# apps/web/.env.local.example, which documents the same value for the
# same reason). If that .env overrides API_PORT locally, use the
# override here too, or requests will hit the wrong port.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Same three values apps/web/.env.local already carries -- a Firebase web
# API key is not a secret (protected by Firebase's own security rules, not
# by being hidden), so reusing web's project/app config here is normal, not
# a leak.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# Optional in development. A production build (APP_VARIANT=production, set by
# eas.json's production profile) refuses to start without all of the above
# plus these, and takes them from the EAS "production" environment, never from
# a committed file -- see docs/MOBILE_RELEASE.md.
#   EXPO_PUBLIC_SITE_URL          https origin of the web app (privacy/terms links)
#   EXPO_PUBLIC_RELEASE_VERSION   release tag for error reports
#   GOOGLE_MAPS_ANDROID_API_KEY   not EXPO_PUBLIC: goes into the Android manifest
EXPO_PUBLIC_SITE_URL=
EXPO_PUBLIC_RELEASE_VERSION=
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional everywhere: error reporting stays off without it. A Sentry DSN is
# public by design (it only allows sending events).
EXPO_PUBLIC_SENTRY_DSN=
