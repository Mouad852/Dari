# expo's optional web-devtools peer (react-dom, via @expo/dom-webview) tracks
# a newer react than the version Expo SDK 57 itself pins for react-native,
# which makes a strict npm install hard-fail on an otherwise-harmless
# optional peer. This app never uses react-dom (no web target build), so
# there is nothing to actually resolve correctly here.
legacy-peer-deps=true
